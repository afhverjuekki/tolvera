// Auto-generated by Tölvera LLM pipeline.
// Source prompt: {{ description }}
//
// Mapping (matches src/tolvera/llm/context/exemplars/boids_osc.py):
//   /metrics/<id>/x   -> SynthDef \freq    via linexp(0,1,{{ pitch_min }},{{ pitch_max }})
//   /metrics/<id>/vel -> SynthDef \amp     via linlin(0,1,0,{{ amp_max }})
//   /metrics/<id>/y   -> SynthDef \cutoff  via linexp(0,1,{{ filter_min }},{{ filter_max }})
//
// The paper text describes "spatial density to filter cutoff"; the OSC stream
// exposes only x, y, smoothed velocity per species, so y substitutes for density.

// Disable audio input — we only generate sound, never record. This avoids
// "Setting sample rate failed" crashes when the system input device runs at
// a different rate than the output (e.g. a 16kHz headset mic vs 44.1kHz
// speakers). Must be set BEFORE s.boot / s.waitForBoot.
s.options.numInputBusChannels = 0;

s.waitForBoot {
    // Low scheduling latency. SuperCollider wraps language-side messages
    // (e.g. synth .set) in bundles timestamped s.latency into the future; the
    // 0.2s default adds a constant lag between an OSC update and the audible
    // result. 0.05 keeps the sound tracking the visuals closely.
    s.latency = 0.05;
    thisProcess.openUDPPort({{ port }});

    {% for synth in synthdefs %}
{% include "supercollider/synthdef.scd.j2" %}

    {% endfor %}
    s.sync;

    ~tolveraSynths = ();

    {% for sp in species %}
{% include "supercollider/responder.scd.j2" %}

    {% endfor %}

    "Tölvera SuperCollider companion ready. Listening on UDP port {{ port }}.".postln;
};

ServerQuit.add({
    OSCdef.freeAll;
    ~tolveraSynths.do { |s| s.free };
});
