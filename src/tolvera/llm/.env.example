# Tölvera LLM Configuration
# Copy this file to .env and add your API keys

# ==============================================================================
# DEFAULT MODEL SETTINGS
# ==============================================================================
# Default provider and model to use when not specified
# Options: gemini, openai, anthropic, mistral, huggingface, ollama
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash

# ==============================================================================
# GOOGLE GEMINI
# ==============================================================================
# Recommended for best results with Tölvera
# Get your API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# For Google Cloud Vertex AI (enterprise users):
# USE_VERTEX_AI=false
# VERTEX_AI_LOCATION=us-central1

# ==============================================================================
# OPENAI
# ==============================================================================
# For GPT-4, GPT-3.5-Turbo and other OpenAI models
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================================================
# ANTHROPIC CLAUDE
# ==============================================================================
# For Claude 3 Opus, Sonnet, and Haiku models
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ==============================================================================
# MISTRAL AI
# ==============================================================================
# For Mistral Large, Small, and other Mistral models
# Get your API key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your-mistral-api-key-here

# ==============================================================================
# HUGGING FACE
# ==============================================================================
# For open-source models hosted on Hugging Face
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# ==============================================================================
# OLLAMA (Local Models)
# ==============================================================================
# For running models locally with Ollama
# No API key needed - just install Ollama: https://ollama.ai/
# Default host (change if running on different machine)
OLLAMA_HOST=http://localhost:11434

# To use Ollama:
# 1. Install Ollama from https://ollama.ai/
# 2. Pull a model: ollama pull llama3.2
# 3. Start Ollama: ollama serve (usually starts automatically)
# 4. Use in Tölvera: model_name="ollama:llama3.2"

# ==============================================================================
# MODEL USAGE EXAMPLES
# ==============================================================================
# You can specify models in several ways:

# 1. Provider:model format (explicit):
#    "openai:gpt-4o"
#    "anthropic:claude-3-5-sonnet-latest"
#    "mistral:mistral-large-latest"
#    "ollama:llama3.2"

# 2. Model name only (auto-detected):
#    "gpt-4" -> uses OpenAI
#    "claude" -> uses Anthropic
#    "gemini-2.0-flash" -> uses Gemini
#    "llama3" -> uses Ollama

# 3. Common aliases:
#    "gpt4" -> "openai:gpt-4o"
#    "claude" -> "anthropic:claude-3-5-sonnet-latest"
#    "gemini-flash" -> "gemini:gemini-2.0-flash"

# ==============================================================================
# PROVIDER COMPARISON
# ==============================================================================
# Provider     | Strengths                    | Cost      | Speed
# -------------|------------------------------|-----------|--------
# Gemini       | Best for Tölvera, reliable   | Low       | Fast
# OpenAI       | GPT-4 quality, wide support  | High      | Medium
# Anthropic    | Claude quality, large context| Medium    | Medium
# Mistral      | Good balance, EU-based       | Low       | Fast
# HuggingFace  | Open models, customizable    | Variable  | Variable
# Ollama       | Local, private, no API costs | Free      | Depends on HW

# ==============================================================================
# TROUBLESHOOTING
# ==============================================================================
# If you encounter issues:
# 1. Ensure your API key is correctly set
# 2. Check your internet connection (except for Ollama)
# 3. Verify the model name is correct
# 4. For Ollama, ensure the server is running: ollama serve
# 5. Check the logs for detailed error messages