{# Jinja2 template for multi-modal integration kernel supporting all expert types #}
{# This template handles: sensors, state transitions, forces, deposits #}
@ti.kernel
def apply_all_experts():
    """Multi-modal kernel that integrates all expert types in proper phases."""
    dt = 0.016  # ~60fps timestep
    
    {% if sensor_experts or state_transition_experts %}
    # === PHASE 1: SENSOR READINGS ===
    # Read environment before making decisions
    {% if sensor_experts %}
    for i in range(tv.pn):
        if tv.p.field[i].active > 0:
            pos = tv.p.field[i].pos
            vel = tv.p.field[i].vel
            species = tv.p.field[i].species
            
            {% for sensor in sensor_experts %}
            # {{ sensor.description }}
            {{ sensor.name }}_reading = {{ sensor.call }}
            # Store sensor reading in appropriate state
            {{ sensor.store_result }}
            {% endfor %}
    {% endif %}
    {% endif %}
    
    {% if state_transition_experts %}
    # === PHASE 2: STATE TRANSITIONS ===
    # Update discrete states based on rules
    for i in range(tv.pn):
        if tv.p.field[i].active > 0:
            {% for transition in state_transition_experts %}
            # {{ transition.description }}
            old_state = {{ transition.get_current_state }}
            new_state = {{ transition.call }}
            {{ transition.update_state }}
            {% endfor %}
    {% endif %}
    
    # === PHASE 3: FORCE CALCULATIONS ===
    # Traditional force-based behaviors
    for i in range(tv.pn):
        if tv.p.field[i].active > 0:
            # TYPED CONTEXT: Particle state
            pos = tv.p.field[i].pos  # type: ti.math.vec2
            vel = tv.p.field[i].vel  # type: ti.math.vec2
            mass = tv.p.field[i].mass  # type: ti.f32
            species = tv.p.field[i].species  # type: ti.i32
            
            # Initialize total force
            total_force = ti.math.vec2(0.0, 0.0)
            
            {% if state_access_code %}
            # State access for force calculations
            {{ state_access_code | indent(12) }}
            {% endif %}
            
            {% if single_particle_experts %}
            # Single-particle forces
            {{ single_expert_calls | indent(12) }}
            {% endif %}
            
            {% if interaction_experts %}
            # Interaction forces
            for j in range(tv.pn):
                if i != j and tv.p.field[j].active > 0:
                    p1 = tv.p.field[i]
                    p2 = tv.p.field[j]
                    {{ interaction_expert_calls | indent(20) }}
            {% endif %}
            
            # Apply forces to velocity
            tv.p.field[i].vel = tv.p.field[i].vel * 0.99 + total_force * dt
            
            # Update position
            new_pos = tv.p.field[i].pos + tv.p.field[i].vel * dt
            
            {% if boundary_code %}
            # Boundary handling
{{ boundary_code }}
            {% else %}
            tv.p.field[i].pos = new_pos
            {% endif %}
    
    {% if deposit_experts %}
    # === PHASE 4: DEPOSITS ===
    # Write to environment after movement
    for i in range(tv.pn):
        if tv.p.field[i].active > 0:
            pos = tv.p.field[i].pos
            vel = tv.p.field[i].vel
            species = tv.p.field[i].species
            
            {% for deposit in deposit_experts %}
            # {{ deposit.description }}
            {{ deposit.call }}
            {% endfor %}
    {% endif %}