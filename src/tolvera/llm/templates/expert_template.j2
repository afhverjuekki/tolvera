{# Jinja2 template for generating expert functions with typed holes approach #}
{# This template generates the wrapper, but the LLM still provides the creative force calculation #}
@ti.func
def expert_{{ name }}({{ parameters }}) -> ti.math.vec2:
    """{{ description }}"""
    # TYPED HOLE[ti.math.vec2]: Force calculation
    # Available inputs: {{ available_inputs }}
    {% if available_states %}
    # Available states: {{ available_states }}
    {% endif %}
    # Type constraints:
    # - Must return ti.math.vec2
    # - Use ti.math.vec2(x, y) to create vectors
    # - Vector operations: .norm(), .normalized(), +, -, *, /
    # - Math functions: ti.sqrt(), ti.sin(), ti.cos(), ti.atan2()
    
    {% if state_declarations %}
    # Type-annotated state access
    {{ state_declarations | indent(4) }}
    {% endif %}
    
    # Initialize force (required for type safety)
    force = ti.math.vec2(0.0, 0.0)
    
    # Force calculation (generated by LLM)
    {{ force_calculation | indent(4) }}
    
    return force