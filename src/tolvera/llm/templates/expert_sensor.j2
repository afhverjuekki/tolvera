{# Jinja2 template for generating sensor expert functions #}
{# This template is for reading environment values (pixels, pheromones, etc.) #}
@ti.func
def expert_{{ name }}({{ parameters }}) -> ti.f32:
    """{{ description }}"""
    # TYPED HOLE[ti.f32]: Sensor reading logic
    # Available inputs: {{ available_inputs }}
    {% if available_states %}
    # Available states: {{ available_states }}
    {% endif %}
    # Type constraints:
    # - Must return ti.f32 (sensed value)
    # - Can read from tv.px.px.rgba[x, y] for pixel values
    # - Can calculate aggregate values from neighbors
    # - Use ti.cast() for type conversions
    
    {% if state_declarations %}
    # Type-annotated state access
    {{ state_declarations | indent(4) }}
    {% endif %}
    
    # Initialize sensed value
    sensed_value = 0.0
    
    # Sensor logic (generated by LLM)
    {{ sensor_logic | indent(4) }}
    
    # CRITICAL: Always return the sensed value
    # If the generated code doesn't return, this ensures we always have a return
    return sensed_value