{# Jinja2 template for generating state transition expert functions #}
{# This template is for discrete state changes like cellular automata #}
@ti.func
def expert_{{ name }}({{ parameters }}) -> ti.i32:
    """{{ description }}"""
    # TYPED HOLE[ti.i32]: State transition logic
    # Available inputs: {{ available_inputs }}
    {% if available_states %}
    # Available states: {{ available_states }}
    {% endif %}
    # Type constraints:
    # - Must return ti.i32 (new state value)
    # - Can read current states and neighbor information
    # - Should implement rule-based logic
    
    {% if state_declarations %}
    # Type-annotated state access
    {{ state_declarations | indent(4) }}
    {% endif %}
    
    # Get current state (required for transitions)
    current_state = 0  # Default state
    {% if current_state_access %}
    {{ current_state_access | indent(4) }}
    {% endif %}
    
    # Initialize new state
    new_state = current_state
    
    # State transition logic (generated by LLM)
    {{ transition_logic | indent(4) }}
    
    return new_state